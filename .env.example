GITHUB_TOKEN=
OPENAI_API_KEY=
GITHUB_WEBHOOK_SECRET=
USER_API_AUTH_TOKEN=
INTERNAL_API_AUTH_TOKEN=

# LLM Configuration - Enterprise/BYOLLM Support
# LLM Provider: openai, anthropic, custom
LLM_PROVIDER=openai

# Custom LLM Base URL (for self-hosted models)
LLM_BASE_URL=

# Model Configuration
LLM_REASONING_MODEL=o3-2025-04-16
LLM_REASONING_CHEAP_MODEL=o3-mini-2025-01-31
LLM_CHEAP_MODEL=gpt-4.1-mini
LLM_EMBEDDING_MODEL=text-embedding-3-large

# API Keys for different providers
ANTHROPIC_API_KEY=
CUSTOM_API_KEY=

# Custom headers for self-hosted models (JSON format)
LLM_CUSTOM_HEADERS={}